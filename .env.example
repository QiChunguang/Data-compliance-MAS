# Frontend
# Empty value means the frontend uses relative /api/v1 paths and Vite proxy in local development.
VITE_REGUTHINK_API_BASE_URL=

# Backend CORS
REGUTHINK_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional runtime flags
REGUTHINK_RUNTIME_ENABLED=false
